# Kumo backend — Render environment variables
# Paste this into Render's "Add from .env" field on the web service's
# Environment tab. Fill in every <PLACEHOLDER> with the real value first.
# NEVER commit this file to git — add it to .gitignore if it isn't already.

# --- Database (from the Render PostgreSQL instance's info page) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-hostname>:<db-port>/<db-name>
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# --- Email (Resend, SMTP) ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<your-resend-api-key-starting-with-re_>
MAIL_FROM=hello@kumo.co.za

# --- CORS: comma-separated, no spaces, no trailing slash ---
KUMO_CORS_ALLOWED_ORIGINS=https://kumohost.co.za,https://kumohost-landing.vercel.app
# --- Security (generate your own: openssl rand -base64 48) ---
JWT_SECRET=<random-base64-string>
VERIFICATION_PROVIDER_KEY=<random-string>
VERIFICATION_WEBHOOK_SECRET=<random-string>
